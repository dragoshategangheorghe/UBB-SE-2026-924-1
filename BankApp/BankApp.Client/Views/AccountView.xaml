<Page
    x:Class="BankApp.Client.Views.AccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="using:BankApp.Client.Utilities"
    mc:Ignorable="d">

    <Page.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utils:DecimalToCurrencyConverter x:Key="CurrencyConverter" />
    </Page.Resources>

    <Grid Padding="40">
        <StackPanel Spacing="20">
            <TextBlock Text="My Bank Accounts" FontSize="28" FontWeight="Bold" />

            <ListView ItemsSource="{Binding Accounts}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" Padding="20" Margin="0,0,0,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding AccountName}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding IBAN}" Opacity="0.6" FontSize="14"/>
                                    <TextBlock Text="{Binding AccountType}" FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Balance, Converter={StaticResource CurrencyConverter}}" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="22" FontWeight="Bold" Foreground="Green"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <ProgressRing IsActive="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                      Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Grid>
</Page>