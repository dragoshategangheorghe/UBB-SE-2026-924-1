@model BankApp.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Account Recovery";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Recovery - BankApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body style="background-color: #202020; overflow-x: hidden;">
    <div class="row vh-100 m-0">
        <div class="col-md-5 d-none d-md-flex flex-column justify-content-center align-items-center p-5" style="background-color: #1A1A2E;">
            <div class="rounded-4 d-flex align-items-center justify-content-center mb-4" style="width: 70px; height: 70px; background-color: #16213E;">
                <span class="fs-1 fw-bold" style="color: #4ECDC4;">B</span>
            </div>
            <h1 class="fw-bold text-white mb-2">Account Recovery</h1>
            <p class="fs-5" style="color: #888;">Get back into your account securely.</p>
        </div>

        <div class="col-md-7 d-flex justify-content-center align-items-center p-5 text-white">
            <div style="max-width: 360px; width: 100%;">
                <h2 class="fw-semibold mb-2">Reset Password</h2>

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="alert alert-success shadow-sm p-2 small" role="alert">@Model.SuccessMessage</div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger shadow-sm p-2 small" role="alert">@Model.ErrorMessage</div>
                    }

                    <form asp-action="ForgotPassword" asp-controller="Auth" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Step" />

                        @if (Model.Step > 1)
                        {
                            <input type="hidden" asp-for="Email" />
                        }

                        @if (Model.Step == 1)
                        {
                            <p class="mb-4 small" style="color: #666;">Enter your email address and we'll send you a code to reset your password.</p>
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label small" style="color: #ccc;"></label>
                                <input asp-for="Email" class="form-control text-white" style="background-color: #2b2b2b; border: 1px solid #444;" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <input type="submit" value="SEND RECOVERY CODE" class="btn w-100 fw-semibold" style="height: 42px; background-color: #4ECDC4; color: white;" />
                        }
                        else if (Model.Step == 2)
                        {
                            <p class="mb-4 small" style="color: #666;">Enter the recovery code sent to your email.</p>
                            <div class="mb-4">
                                <label asp-for="Token" class="form-label small" style="color: #ccc;"></label>
                                <input asp-for="Token" class="form-control text-white" style="background-color: #2b2b2b; border: 1px solid #444;" autofocus />
                            </div>
                            <input type="submit" value="VERIFY CODE" class="btn w-100 fw-semibold mb-3" style="height: 42px; background-color: #4ECDC4; color: white;" />
                        }
                        else if (Model.Step == 3)
                        {
                            <input type="hidden" asp-for="Token" />
                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label small" style="color: #ccc;">New Password</label>
                                <input asp-for="NewPassword" type="password" class="form-control text-white" style="background-color: #2b2b2b; border: 1px solid #444;" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label small" style="color: #ccc;">Confirm New Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control text-white" style="background-color: #2b2b2b; border: 1px solid #444;" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <input type="submit" value="CONFIRM NEW PASSWORD" class="btn w-100 fw-semibold" style="height: 42px; background-color: #4ECDC4; color: white;" />
                        }
                    </form>
                }

                <div class="text-center mt-4 small">
                    <a asp-action="Index" class="text-decoration-none" style="color: #888;">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>