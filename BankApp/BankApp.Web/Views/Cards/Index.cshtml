@model BankApp.Web.Models.Cards.CardManagementPageViewModel

@{
    ViewData["Title"] = "Card Management";
}

<div class="container py-4">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-danger">@Model.StatusMessage</div>
    }

    <div id="cardsStatusBox" class="alert d-none"></div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="mb-3">
                <h2 class="fw-bold">Card Management</h2>
                <p class="text-muted">Manage card preferences, limits, and secure card detail reveal.</p>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">Sort Cards</h5>

                    <select id="sortOption" class="form-select mb-3">
                        @foreach (var option in Model.SortOptions)
                        {
                            if (option.Value == Model.SelectedSortOption)
                            {
                                <option value="@option.Value" selected>@option.Label</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        }
                    </select>

                    <div class="d-flex gap-2">
                        <button id="applySortBtn" class="btn btn-primary">Apply Sort</button>
                        <a asp-controller="Cards" asp-action="Index" class="btn btn-outline-secondary">Refresh</a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Cards</h5>

                    @if (Model.Cards.Count == 0)
                    {
                        <p class="text-muted mb-0">No cards available.</p>
                    }
                    else
                    {
                        <div class="list-group" id="cardsList">
                            @foreach (var card in Model.Cards)
                            {
                                var isSelected = Model.SelectedCard?.Id == card.Id ? "active" : "";

                                <button type="button"
                                        class="list-group-item list-group-item-action card-item @isSelected"
                                        data-card-id="@card.Id"
                                        data-cardholder="@card.CardholderName"
                                        data-masked="@card.MaskedCardNumber"
                                        data-accountname="@card.AccountName"
                                        data-accountiban="@card.AccountIban"
                                        data-status="@card.Status"
                                        data-expiry="@card.ExpiryDate"
                                        data-brand="@card.CardBrand"
                                        data-limit="@card.SpendingLimit"
                                        data-online="@card.IsOnlinePaymentsEnabled.ToString().ToLower()"
                                        data-contactless="@card.IsContactlessPaymentsEnabled.ToString().ToLower()">
                                    <div class="fw-semibold">@card.CardholderName</div>
                                    <div class="text-muted small">@card.MaskedCardNumber</div>
                                    <div class="text-muted small">@card.AccountName</div>
                                    <div class="small mt-1">@card.Status | @card.CardBrand | @card.ExpiryDate</div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Selected Card</h4>

                    <input type="hidden" id="selectedCardId" value="@Model.SelectedCard?.Id" />

                    <div id="noCardPanel" class="@(Model.SelectedCard == null ? "" : "d-none")">
                        <p class="text-muted mb-0">Select a card to view its details.</p>
                    </div>

                    <div id="selectedCardPanel" class="@(Model.SelectedCard != null ? "" : "d-none")">
                        <h5 id="selectedCardholder" class="fw-semibold">@Model.SelectedCard?.CardholderName</h5>

                        <div class="mt-3">
                            <div class="fw-semibold">Card Number</div>
                            <div id="selectedMaskedNumber" class="text-muted">@Model.SelectedCard?.MaskedCardNumber</div>
                        </div>

                        <div class="mt-3">
                            <div class="fw-semibold">Account</div>
                            <div id="selectedAccountName" class="text-muted">@Model.SelectedCard?.AccountName</div>
                        </div>

                        <div class="mt-3">
                            <div class="fw-semibold">Account IBAN</div>
                            <div id="selectedAccountIban" class="text-muted">@Model.SelectedCard?.AccountIban</div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="fw-semibold">Status</div>
                                <div id="selectedStatus">@Model.SelectedCard?.Status</div>
                            </div>
                            <div class="col-md-6">
                                <div class="fw-semibold">Expiry</div>
                                <div id="selectedExpiry">@Model.SelectedCard?.ExpiryDate</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Controls</h4>

                    <div class="mb-3">
                        <label for="spendingLimit" class="form-label fw-semibold">Spending Limit</label>
                        <input id="spendingLimit"
                               class="form-control"
                               type="number"
                               step="0.01"
                               value="@Model.SelectedCard?.SpendingLimit" />
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input id="onlinePayments"
                               class="form-check-input"
                               type="checkbox"
                        @(Model.SelectedCard?.IsOnlinePaymentsEnabled == true ? "checked" : null) />
                        <label class="form-check-label" for="onlinePayments">Online Payments</label>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input id="contactlessPayments"
                               class="form-check-input"
                               type="checkbox"
                        @(Model.SelectedCard?.IsContactlessPaymentsEnabled == true ? "checked" : null) />
                        <label class="form-check-label" for="contactlessPayments">Contactless Payments</label>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button id="freezeBtn" class="btn btn-warning">Freeze Card</button>
                        <button id="unfreezeBtn" class="btn btn-success">Unfreeze Card</button>
                        <button id="saveSettingsBtn" class="btn btn-primary">Save Settings</button>
                        <button id="revealBtn" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#revealModal">
                            Reveal Details
                        </button>
                    </div>
                </div>
            </div>

            <div id="sensitiveDetailsPanel" class="card border-info d-none">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Sensitive Details</h4>

                    <div class="mb-2">
                        <div class="fw-semibold">Card Number</div>
                        <div id="revealedCardNumber"></div>
                    </div>

                    <div class="mb-2">
                        <div class="fw-semibold">CVV</div>
                        <div id="revealedCvv"></div>
                    </div>

                    <div id="revealCountdown" class="text-muted small mb-3"></div>

                    <button id="hideSensitiveBtn" class="btn btn-outline-secondary btn-sm">Hide Now</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="revealModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reveal Card Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label for="revealPassword" class="form-label">Password</label>
                    <input id="revealPassword" type="password" class="form-control" />
                </div>

                <div>
                    <label for="revealOtp" class="form-label">OTP Code</label>
                    <input id="revealOtp" type="text" class="form-control" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmRevealBtn" class="btn btn-primary">Reveal</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cards.js" asp-append-version="true"></script>
}
