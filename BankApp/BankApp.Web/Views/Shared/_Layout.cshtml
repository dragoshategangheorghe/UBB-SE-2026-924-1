</header>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <div class="col-auto bg-primary px-1 pt-3">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                    <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                        <div class="d-flex gap-2">
                            <span style="background-color: #16213E; padding: 1em; padding-bottom: 0.4em; padding-top: 0.4em; border-radius: 10px;">&#xE8AB;</span>
                            <span class="fs-5 d-none d-sm-inline text-center" style="font-weight: bold;">BankApp</span>
                            <div class="ps-4">&#xEA8F;</div>
                            <div class="">0</div> <!-- Here put the notification badge -->
                        </div>
                    </a>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "custom-active" : "")" asp-area="" asp-controller="Dashboard" asp-action="Index">&#xE80F;<span class="ms-2 d-none d-sm-inline">Dashboard</span></a>
                                                                                                                                                </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Accounts" ? "custom-active" : "")" asp-area="" asp-controller="Accounts" asp-action="Index">&#xE8C8;<span class="ms-2 d-none d-sm-inline">Accounts</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transfers" ? "custom-active" : "")" asp-area="" asp-controller="Transfers" asp-action="Index">&#xE8AB;<span class="ms-2 d-none d-sm-inline">Transfers</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "BillPayments" ? "custom-active" : "")" asp-area="" asp-controller="BillPayments" asp-action="Index">&#xE8C7;<span class="ms-2 d-none d-sm-inline">Bill Payments</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cards" ? "custom-active" : "")" asp-area="" asp-controller="Cards" asp-action="Index">&#xE8C0;<span class="ms-2 d-none d-sm-inline">Cards</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TransferHistory" ? "custom-active" : "")" asp-area="" asp-controller="Transactions" asp-action="Index">&#xE81C;<span class="ms-2 d-none d-sm-inline">Transfer History</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CurrencyExchange" ? "custom-active" : "")" asp-area="" asp-controller="CurrencyExchange" asp-action="Index">&#xE8B1;<span class="ms-2 d-none d-sm-inline">Currency Exchange</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isSavingsAndLoansSection ? "custom-active" : "")" asp-area="" asp-controller="Savings" asp-action="Index">&#xE719;<span class="ms-2 d-none d-sm-inline">Savings & Loans</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "InvestmentsAndTrading" ? "custom-active" : "")" asp-area="" asp-controller="InvestmentsAndTrading" asp-action="Index">&#xE9D9;<span class="ms-2 d-none d-sm-inline">Investments & Trading</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Statistics" ? "custom-active" : "")" asp-area="" asp-controller="Statistics" asp-action="Index">&#xE9D2;<span class="ms-2 d-none d-sm-inline">Statistics</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Support" ? "custom-active" : "")" asp-area="" asp-controller="Chat" asp-action="Index">&#xE897;<span class="ms-2 d-none d-sm-inline">Support</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "custom-active" : "")" asp-area="" asp-controller="Profile" asp-action="Index">&#xE80F;<span class="ms-2 d-none d-sm-inline">Profile</span></a>
                        </li>
                        <li class="nav-item mt-5">
                            <a class="nav-link" onmouseout="this.style.color='#FF6B6B'" onmouseover="this.style.color='#d84545'" style="color: #FF6B6B" asp-area="" asp-controller="Auth" asp-action="LogOut">&#xE77B;<span class="ms-2 d-none d-sm-inline">Log Out</span></a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

        <footer class="app-footer">
        </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
