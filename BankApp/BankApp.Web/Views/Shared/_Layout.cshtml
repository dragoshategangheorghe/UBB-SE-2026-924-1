@inject BankApp.Web.Infrastructure.IWebSessionContext SessionContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BankApp.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BankApp.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-frame">
        <header class="topbar">
            <nav class="navbar navbar-expand-lg">
                <div class="container-xxl">
                    <a class="navbar-brand" asp-controller="Savings" asp-action="Index">BankApp</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appNav" aria-controls="appNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="appNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Savings" asp-action="Index">Savings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Loans" asp-action="Index">Loans</a>
                            </li>
                        </ul>
                        <div class="topbar-actions">
                            @if (SessionContext.IsAuthenticated)
                            {
                                <span class="session-chip">Authenticated session</span>
                            }
                            else
                            {
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="Auth" asp-action="Index">Login</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <main class="app-body container-xxl">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <div class="container-xxl">
                <span>BankApp Web</span>
                <span>Loans and savings</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
